{
  "title": "Eric's Arc for Chrome",
  "rules": [
    {
      "description": "Chrome: Ctrl+Tab / Ctrl+Shift+Tab switch recent tabs (sends Ctrl+. / Ctrl+Shift+. / Ctrl+, to the extension; letting go of Control starts over)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": ["control", "shift"] } },
          "to": [
            { "key_code": "comma", "modifiers": ["control"] },
            { "set_variable": { "name": "arc_for_chrome_tab_walk", "value": 1 } }
          ],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": ["control"] } },
          "to": [{ "key_code": "period", "modifiers": ["control", "shift"] }],
          "conditions": [
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] },
            { "type": "variable_if", "name": "arc_for_chrome_tab_walk", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": ["control"] } },
          "to": [
            { "key_code": "period", "modifiers": ["control"] },
            { "set_variable": { "name": "arc_for_chrome_tab_walk", "value": 1 } }
          ],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "left_control", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_control" }],
          "to_after_key_up": [{ "set_variable": { "name": "arc_for_chrome_tab_walk", "value": 0 } }]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_control", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_control" }],
          "to_after_key_up": [{ "set_variable": { "name": "arc_for_chrome_tab_walk", "value": 0 } }]
        }
      ]
    }
  ]
}
